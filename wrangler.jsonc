{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": ["nodejs_compat"],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WebSocketServer"],
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WEBSOCKET",
        "class_name": "WebSocketServer",
      },
    ],
  },


  // 
